# Copy to .env and fill in the values.
PORT=5000

# Credentials of the AWS account to scan, read by the AWS SDK's default credential chain.
# The IAM user needs read-only access (the AWS-managed SecurityAudit policy covers all
# scans and CIS checks) plus dynamodb:ListTables for the startup connection check.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region for DynamoDB and for global calls (S3 ListBuckets, IAM, EC2 DescribeRegions)
AWS_REGION=us-east-1
